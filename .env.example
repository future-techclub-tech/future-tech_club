SECRET_KEY=change-this-to-a-long-random-secret
APP_ENV=development
SESSION_COOKIE_SECURE=false
# Set the admin username/password before first startup and keep .env private.
BOOTSTRAP_ADMIN_USERNAME=24062231242187
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# TEAM_INITIAL_PASSWORD=optional-shared-development-password
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost/future_tech_innovision
# SQLite is used if DATABASE_URL is not set:
DATABASE_URL=sqlite:///future_tech_innovision.db
# Render sets this to its persistent disk path; local development can use the default.
# UPLOAD_FOLDER=/var/data/uploads
# Optional canonical public URL for certificate QR links (use your deployed HTTPS domain).
# CERTIFICATE_PUBLIC_BASE_URL=https://your-public-domain.example
# Task assignment email: configure SMTP credentials for the authorized club mailbox.
# TASK_EMAIL_SMTP_HOST=
# TASK_EMAIL_SMTP_PORT=587
# TASK_EMAIL_SMTP_USERNAME=future-techclub@orchidengg.ac.in
# TASK_EMAIL_SMTP_PASSWORD=
# TASK_EMAIL_FROM=future-techclub@orchidengg.ac.in
# MSG91 SMS task notifications (optional; keep credentials private):
# TASK_SMS_AUTH_KEY=
# TASK_SMS_TEMPLATE_ID=
# TASK_SMS_VARIABLE_NAME=VAR1
# TASK_SMS_COUNTRY_CODE=91
